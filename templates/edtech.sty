%% ---------------------------------------------------------------- practice sheet
\newcounter{prob}
\newtoks\et@sols
\newif\ifet@solinline \et@solinlinefalse
\newcommand\solutionsinline{\et@solinlinetrue}
\newcommand\solutionsatend{\et@solinlinefalse}
\newcommand\problabel{Problem-\twodigit{\value{prob}}}
%  \problem{text}[source]{short answer}
\NewDocumentCommand\problem{+m o m}{\refstepcounter{prob}\par\smallskip
  \noindent{\latinserif\large\problabel}\,: #1\IfValueTF{#2}{\srctag{#2}}{\par}
  \nopagebreak\noindent\textbf{উত্তর :} #3\par\medskip}
%  \pmcq[source]{stem}{a}{b}{c}{d}{answer}  — MCQ inside a practice sheet (answer shown below)
\NewDocumentCommand\pmcq{o +m m m m m m}{\refstepcounter{prob}\par\smallskip
  \noindent\begin{minipage}{\linewidth}% question + options + answer never split
  \noindent{\latinserif\large\problabel}\,: #2\IfValueTF{#1}{\srctag{#1}}{\par}
  \begingroup\options{#3}{#4}{#5}{#6}\endgroup
  \noindent\textbf{উত্তর :} #7\end{minipage}\par\medskip}
%  \solution{full working} — inline or collected to the end (\printsolutions)
\NewDocumentCommand\solution{+m}{\ifet@solinline
   \begin{tcolorbox}[etbase,colback=etfill,colframe=etaccent,boxrule=0.4pt,arc=3pt,title={\small\headfont\bfseries সমাধান: \problabel},colbacktitle=etaccent]#1\end{tcolorbox}
  \else\edef\et@tmp{\noexpand\et@solitem{\problabel}}%
   \global\et@sols\expandafter{\the\expandafter\et@sols\et@tmp{#1}}\fi}
\newcommand\printsolutions[1][সমাধান]{\par\medskip\topicbar{#1}\par
  \def\et@solitem##1##2{\par\smallskip\noindent{\latinserif\bfseries ##1}\,:\par\nobreak ##2\par\medskip}%
  \begin{multicols}{2}\the\et@sols\end{multicols}}

